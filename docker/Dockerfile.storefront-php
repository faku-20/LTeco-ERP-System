FROM composer:2 AS vendor

WORKDIR /app

COPY storefront/composer.json storefront/composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts \
    --no-progress

FROM php:8.4-fpm-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libcurl4-openssl-dev \
        libicu-dev \
        libonig-dev \
        libsqlite3-dev \
        libxml2-dev \
        libzip-dev \
        unzip \
    && docker-php-ext-install -j2 \
        bcmath \
        curl \
        intl \
        mbstring \
        opcache \
        pcntl \
        pdo_mysql \
        pdo_sqlite \
        zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 \
    /usr/bin/composer \
    /usr/local/bin/composer

COPY docker/php-storefront.ini \
    /usr/local/etc/php/conf.d/zz-storefront.ini

WORKDIR /var/www/html

COPY storefront /var/www/html

COPY --from=vendor \
    /app/vendor \
    /var/www/html/vendor

RUN rm -f /var/www/html/.env \
    && chown -R root:www-data /var/www/html \
    && chmod -R g+rX,o-rwx /var/www/html \
    && mkdir -p \
        database \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && touch database/database.sqlite \
    && rm -f bootstrap/cache/*.php \
    && chown -R www-data:www-data \
        database \
        storage \
        bootstrap/cache

USER www-data

RUN php artisan package:discover --ansi

EXPOSE 9000

CMD ["php-fpm"]
