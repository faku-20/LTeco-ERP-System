APP_NAME="CommerceOps Storefront"
APP_ENV=staging
APP_KEY=
CUSTOMER_BLIND_INDEX_KEY=
AUDIT_HASH_KEY=
APP_DEBUG=false
APP_URL=https://storefront.example.com
STOREFRONT_PRODUCTION_URL=https://example.com
# Staging siempre debe permanecer fuera de índices. Activar únicamente al
# publicar el dominio definitivo y después de revisar canonicales/sitemap.
STOREFRONT_INDEXABLE=false
GOOGLE_SITE_VERIFICATION=
# Usar solamente la IP o el CIDR del proxy Nginx. No usar `*` en producción.
TRUSTED_PROXIES=172.16.0.0/12

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_UY
APP_TIMEZONE=America/Montevideo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base propia del storefront: cuentas, sesiones y pedidos web.
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=lteco_storefront
DB_USERNAME=storefront_app
DB_PASSWORD=

# Catálogo comercial existente: conexión estrictamente de lectura.
CATALOG_DB_CONNECTION=mysql
CATALOG_DB_HOST=host.docker.internal
CATALOG_DB_PORT=3306
CATALOG_DB_DATABASE=lteco_db_poo
CATALOG_DB_USERNAME=storefront_reader
CATALOG_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="CommerceOps"

VITE_APP_NAME="${APP_NAME}"

STOREFRONT_BRAND_NAME=CommerceOps
STOREFRONT_BRAND_TAGLINE="Gestión comercial integral"
STOREFRONT_BUSINESS_CATEGORY="productos y servicios"
STOREFRONT_WHATSAPP_NUMBER=
STOREFRONT_WHATSAPP_DISPLAY=
STOREFRONT_INSTAGRAM_LABEL="@tuempresa"
STOREFRONT_INSTAGRAM_URL=https://instagram.com/tuempresa
STOREFRONT_CONTACT_LOCATION="Tu zona de atención"
STOREFRONT_CONTACT_EMAIL=
STOREFRONT_CONTACT_HOURS="Horario a coordinar"
STOREFRONT_CONTACT_MAP_URL=
# Valor inicial editable de la calculadora; dejar 0 si no hay tarifa aprobada.
STOREFRONT_DEFAULT_TICKET_PRICE=0

# Carrito invitado.
STOREFRONT_CART_COOKIE=commerceops_guest_cart
STOREFRONT_CART_LIFETIME_MINUTES=43200
STOREFRONT_CART_MAX_QUANTITY=10
STOREFRONT_CART_MAX_UNITS_PER_ORDER=10
STOREFRONT_CART_SECURE_COOKIE=true

# API privada Laravel -> panel.
PANEL_API_BASE_URL=http://panel/lteco-panel/api/storefront/v1
PANEL_API_KEY_ID=storefront-current
PANEL_API_SECRET=
# Solo para desarrollo detrás de un proxy local HTTP que representa HTTPS.
PANEL_API_FORWARDED_PROTO=
PANEL_API_ALLOW_INSECURE=false

# API privada panel -> Laravel. Usar secretos distintos a los anteriores.
STOREFRONT_INTERNAL_KEY_ID=panel-current
STOREFRONT_INTERNAL_SECRET=
STOREFRONT_INTERNAL_PREVIOUS_KEY_ID=
STOREFRONT_INTERNAL_PREVIOUS_SECRET=

# Cuentas de clientes.
# Habilitar solamente después de configurar correo real.
STOREFRONT_ACCOUNTS_ENABLED=false
STOREFRONT_REGISTRATION_ENABLED=false

# Pago online: preparado, pero bloqueado hasta definir contrato/proveedor.
STOREFRONT_PAYMENT_PROVIDER=none
STOREFRONT_ONLINE_PAYMENTS_ENABLED=false
# Simulador interno de tarjeta. Default/prod: false. Habilitar solo en entornos
# de prueba explícitamente autorizados.
STOREFRONT_PAYMENT_SIMULATOR_ENABLED=false
GETNET_ENVIRONMENT=sandbox
GETNET_MERCHANT_ID=
GETNET_TERMINAL_ID=
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
GETNET_WEBHOOK_SECRET=

# La limpieza automática se activa únicamente después de aprobar formalmente
# la política de conservación y las obligaciones fiscales/documentales.
PRIVACY_MAINTENANCE_ENABLED=false
SECURITY_AUDIT_RETENTION_DAYS=730
