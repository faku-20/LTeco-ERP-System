# Copiar a .env y ajustar en el servidor. NO subir .env al repositorio.
LTECO_ENV=production
LTECO_DEBUG=0
LTECO_FORCE_HTTPS=1
LTECO_PANEL_BASE_URL=/lteco-panel
LTECO_PUBLIC_BASE_URL=/public-web
LTECO_PANEL_PUBLIC_URL=
LTECO_PUBLIC_URL=
LTECO_VERIFY_PUBLIC_URL=https://example.com/verificar-comprobante.php
LTECO_APP_NAME=CommerceOps
LTECO_PANEL_NAME=Panel CommerceOps
LTECO_APP_TAGLINE=Gestión comercial integral
LTECO_BUSINESS_CATEGORY=productos y servicios
LTECO_SUPPORT_TEAM_NAME=Equipo CommerceOps

LTECO_DB_HOST=host.docker.internal
LTECO_DB_NAME=lteco_db
LTECO_DB_USER=lteco_user
LTECO_DB_PASS=CAMBIAR_ESTA_CLAVE
LTECO_DB_DEBUG=0
LTECO_PUBLIC_DB_USER=
LTECO_PUBLIC_DB_PASS=

LTECO_DEFAULT_EXCHANGE_RATE=42.00
LTECO_DEFAULT_IVA_RATE=22.00
LTECO_DEFAULT_WHATSAPP=59892000086
LTECO_WHATSAPP_TEST_PHONE=
LTECO_DEFAULT_EMPRESA_RUT=123456789012
LTECO_SESSION_IDLE_SECONDS=7200
LTECO_SESSION_REGENERATE_SECONDS=1800
LTECO_COMPROBANTE_SECRET=CAMBIAR_SECRET_LARGO_ALEATORIO
LTECO_VERIFY_RATE_LIMIT=60
LTECO_VERIFY_RATE_WINDOW_SECONDS=3600
LTECO_TURNSTILE_SITE_KEY=
LTECO_TURNSTILE_SECRET_KEY=
LTECO_WHATSAPP_PHONE_NUMBER_ID=
LTECO_WHATSAPP_ACCESS_TOKEN=
LTECO_WHATSAPP_BUSINESS_ACCOUNT_ID=
LTECO_WHATSAPP_WEBHOOK_VERIFY_TOKEN=CAMBIAR_TOKEN_LARGO_ALEATORIO
LTECO_META_APP_SECRET=CAMBIAR_META_APP_SECRET

# IA comercial. Mantener desactivada hasta configurar y validar el proveedor.
LTECO_AI_ENABLED=0
LTECO_AI_PROVIDER=openai
LTECO_AI_BASE_URL=https://api.openai.com/v1
LTECO_AI_API_KEY=
LTECO_AI_MODEL=gpt-4o-mini
LTECO_AI_MAX_OUTPUT_TOKENS=900
LTECO_AI_CLASSIFY_ON_WEBHOOK=1
LTECO_AI_AUTO_REPLY_ENABLED=0

# Integraciones internas. Usar secretos largos y diferentes entre sí.
LTECO_N8N_WEBHOOK_TOKEN=
LTECO_SCANNER_SECRET=

LTECO_WEB_PUSH_ENABLED=1
LTECO_WEB_PUSH_VAPID_SUBJECT=https://panel.example.com
LTECO_WEB_PUSH_VAPID_PUBLIC_KEY=
LTECO_WEB_PUSH_VAPID_PRIVATE_KEY=
LTECO_WEB_SALES_NOTIFY_WEB_PUSH=0

# Telegram interno para avisos de nuevas ventas web. No versionar el token real.
LTECO_TELEGRAM_ENABLED=0
LTECO_TELEGRAM_BOT_TOKEN=
LTECO_TELEGRAM_CHAT_IDS=
LTECO_TELEGRAM_START_AT=
# Proxies confiables para tomar CF-Connecting-IP / X-Forwarded-For.
# Por defecto el panel confía en loopback y rangos privados Docker; agregar IP/CIDR públicos solo si aplica.
LTECO_TRUSTED_PROXY_RANGES=
LTECO_MFA_ENCRYPTION_KEY=CAMBIAR_SECRET_LARGO_ALEATORIO_PARA_MFA

# Backups fuera del webroot. Crear este directorio en el host/contenedor con permisos de escritura.
LTECO_BACKUP_DIR=/opt/backups/commerceops
LTECO_DB_BACKUP_HOST=host.docker.internal

# Ecommerce. Pago online cerrado hasta aprobar proveedor y contrato Getnet.
LTECO_PAYMENT_PROVIDER=none
LTECO_GETNET_WEBHOOK_SECRET=

# Notificaciones email (Gmail SMTP)
LTECO_MAIL_HOST=
LTECO_MAIL_PORT=587
LTECO_MAIL_USER=
LTECO_MAIL_PASS=
LTECO_MAIL_FROM=no-reply@example.com
LTECO_MAIL_NAME=CommerceOps
LTECO_MAIL_TO=
LTECO_WEB_SALES_NOTIFY_EMAILS=
LTECO_WEB_SALES_NOTIFY_WHATSAPP=
LTECO_MAIL_EHLO_HOST=example.com
LTECO_MAIL_MESSAGE_ID_DOMAIN=example.com
# API privada consumida por el storefront Laravel. Usar secretos largos y distintos
# de cualquier clave de sesión, correo o base de datos.
LTECO_STOREFRONT_API_CURRENT_KEY_ID=storefront-current
LTECO_STOREFRONT_API_CURRENT_SECRET=
LTECO_STOREFRONT_API_PREVIOUS_KEY_ID=
LTECO_STOREFRONT_API_PREVIOUS_SECRET=
LTECO_STOREFRONT_API_RATE_PER_MINUTE=120
LTECO_MEDIA_PUBLIC_URL=http://localhost:8081/lteco-panel
LTECO_STOREFRONT_PUBLIC_URL=https://storefront.example.com
LTECO_STOREFRONT_PAYMENT_SIMULATOR_ENABLED=false
LTECO_ECOMMERCE_MAIL_ENABLED=0
